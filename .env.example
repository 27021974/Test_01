# ──────────────────────────────────────────────
# Marktbeobachtungs-WebApp – Umgebungsvariablen
# Kopiere diese Datei als `.env` und passe sie an
# ──────────────────────────────────────────────

# Datenbank
DATABASE_URL=sqlite+aiosqlite:///./data/marktbeobachtung.db

# Sicherheit: Token zum Schutz des manuellen Fetch-Endpoints
API_TOKEN=change-me-in-production

# Debug-Modus (True/False)
DEBUG=False

# Scheduler: Stunde (UTC), zu der der tägliche Fetch läuft (0-23)
SCHEDULER_HOUR=3

# HTTP-Timeout in Sekunden
HTTP_TIMEOUT=30

# ── Quellen-Konfiguration ──────────────────────

# Unternehmensregister / insolvenzbekanntmachungen.de
UR_ENABLED=True
UR_MODE=rss    # rss | degraded

# Creditreform (immer degraded – keine öffentliche API)
CR_ENABLED=True
CR_MODE=degraded
